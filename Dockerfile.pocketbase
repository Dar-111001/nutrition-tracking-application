FROM alpine:3.20
ARG PB_VERSION=0.22.20

# sqlite is only for seed/check_seed.sh, which checks the database with plain SQL
RUN apk add --no-cache unzip ca-certificates wget curl jq sqlite

# Download PocketBase for the correct CPU architecture
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
        x86_64)  PB_ARCH="amd64" ;; \
        aarch64) PB_ARCH="arm64" ;; \
        *)       PB_ARCH="amd64" ;; \
    esac && \
    wget -q "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${PB_ARCH}.zip" \
    && unzip "pocketbase_${PB_VERSION}_linux_${PB_ARCH}.zip" \
    && mv pocketbase /usr/local/bin/pocketbase \
    && rm "pocketbase_${PB_VERSION}_linux_${PB_ARCH}.zip"

COPY pb_setup.sh /pb_setup.sh
RUN chmod +x /pb_setup.sh
# Built-in foods, loaded once into a fresh database by pb_setup.sh, and the
# SQL check that proves they loaded (docker compose exec pocketbase /pb_seed/check_seed.sh)
COPY seed/foods.json seed/check_seed.sql seed/check_seed.sh /pb_seed/
RUN chmod +x /pb_seed/check_seed.sh

# All state lives here: mount a persistent volume (docker volume locally, EFS on ECS)
ENV PB_PORT=8090 \
    PB_DATA_DIR=/pb/pb_data
VOLUME ["/pb/pb_data"]
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD curl -sf "http://127.0.0.1:${PB_PORT}/api/health" > /dev/null || exit 1
ENTRYPOINT ["/pb_setup.sh"]
