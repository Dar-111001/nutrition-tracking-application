# nginx config for the app container.
#
# The nginx image renders this template at startup, replacing ${VARS} with env vars
# (only vars that are set, so nginx's own $variables are left alone):
#   PORT              port the app listens on (default 80)
#   API_URL           where the Node API is reachable from this container
#                     (compose: http://api:4000, ECS same task: http://localhost:4000)
#   POCKETBASE_URL    where PocketBase is reachable, only for its admin UI at /_/
#   HEALTHCHECK_PATH  health check route (see healthcheck-env.sh)
#
# The browser only ever talks to this server: static files, /api forwarded to
# the Node API, and /_/ to the PocketBase admin UI. One public port, no CORS,
# no backend URL in the JS bundle.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;

    # Health check for ECS / load balancer target groups. Asks the API's readiness
    # check, which also checks PocketBase, so a broken backend takes the task out of rotation.
    location = ${HEALTHCHECK_PATH} {
        access_log off;
        proxy_pass ${API_URL}/api/ready;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    # Our REST API
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 70s;
        # If the API itself is down, still answer in the API's JSON shape
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        return 503 '{"ok":false,"error":{"code":"server","message":"The API is unavailable. Try again in a moment.","details":null}}';
    }

    # PocketBase admin UI (manage data and users)
    location /_/ {
        proxy_pass ${POCKETBASE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static assets with caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # All routes fall back to index.html (React Router SPA support)
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
