# PocketBase admin (admin UI at http://localhost:3000/_/)
PB_ADMIN_EMAIL=admin@nutrition.local
PB_ADMIN_PASSWORD=ChangeMe1234!

# Login for the app itself. Optional: defaults to the admin email/password above.
# APP_USER_EMAIL=me@example.com
# APP_USER_PASSWORD=ChangeMe1234!

# CPU architecture the images are built for. linux/amd64 (the default) runs on
# every cloud stack. On an Apple Silicon Mac you can set linux/arm64 for faster
# local runs, but switch back before pushing to Cloud Run or Container Apps.
# DOCKER_PLATFORM=linux/arm64
